# OMGTU group id from rasp.omgtu.ru
GROUP_ID=703

# From service account JSON: client_email + private_key
GOOGLE_CLIENT_EMAIL=lessons-calendar@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Calendar that is shared with GOOGLE_CLIENT_EMAIL (Make changes to events).
# Find id in Calendar settings → Integrate calendar.
GOOGLE_CALENDAR_ID=

# Cron: every 6 hours (two-week validation window)
CRON_SCHEDULE=0 */6 * * *

# Lesson times are interpreted in this timezone
SCHEDULE_TIMEZONE=Asia/Omsk

# Optional override
# RASP_BASE_URL=https://rasp.omgtu.ru/api/schedule/group
